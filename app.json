{
  "expo": {
    "name": "DecoTrack",
    "slug": "decotrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "no.decobygg.decotrack",
      "versionCode": 1,
      "permissions": ["CAMERA"]
    },
    "plugins": [
      ["expo-camera", {
        "cameraPermission": "Allow DecoTrack to scan tool and tool-bag QR codes."
      }]
    ]
  }
}
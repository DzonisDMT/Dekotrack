{
  "expo": {
    "name": "DecoTrack",
    "slug": "decotrack",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "no.decobygg.decotrack",
      "versionCode": 2,
      "permissions": [
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow DecoTrack to scan tool and tool-bag QR codes."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/decobygg-logo.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    }
  }
}
